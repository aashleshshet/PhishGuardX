# Docker-only: set a strong local development password before docker compose up.
POSTGRES_PASSWORD=replace-this-local-development-password
# Local API (optional; omit to keep browser-only history):
# DATABASE_URL=postgresql://phishguard:YOUR_PASSWORD@127.0.0.1:5432/phishguard

# Independent OpenPhish.eu lookup API (anonymous: 100 requests/hour).
OPENPHISH_API_ENABLED=true
OPENPHISH_API_URL=https://openphish.eu/api/check
OPENPHISH_TIMEOUT=10
OPENPHISH_CACHE_TTL=900
OPENPHISH_API_HOURLY_LIMIT=90

# Independent OpenPhish.com Community Feed. Set the source only after confirming
# rights for your deployment. No source = no download, even with these flags on.
OPENPHISH_FEED_ENABLED=true
OPENPHISH_FEED_SYNC_ENABLED=true
OPENPHISH_FEED_URL=
OPENPHISH_FEED_PERMISSION_CONFIRMED=false
OPENPHISH_FEED_INTERVAL_SECONDS=43200
OPENPHISH_FEED_MAX_AGE_SECONDS=129600
OPENPHISH_DB_PATH=.data/threats.sqlite3
# Persistent PostgreSQL is required for hosted feed sync. Never expose this value.
THREAT_DATABASE_URL=
# Generate a long random secret for the protected scheduler endpoint.
CRON_SECRET=

# Optional independent providers. No fabricated results when disabled/unconfigured.
PHISHTANK_ENABLED=false
PHISHTANK_API_KEY=
GOOGLE_SAFE_BROWSING_ENABLED=false
GOOGLE_SAFE_BROWSING_API_KEY=
URLHAUS_ENABLED=false
URLHAUS_AUTH_KEY=
